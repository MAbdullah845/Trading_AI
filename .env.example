# Bazaar PSX Terminal - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Bazaar PSX Terminal
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/bazaar
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/bazaar

# API Credentials (NEVER hardcode these)
PSX_API_KEY=your_api_key_here
PSX_API_URL=https://api.psx.com/v1
PSX_API_SECRET=your_api_secret_here

# PyPSX Trading SDK Credentials (get from https://markets.pypsx.com)
# Keys start with PK_
PYPSX_API_KEY_ID=PK_YOUR_KEY_ID_HERE
PYPSX_API_SECRET_KEY=YOUR_SECRET_KEY_HERE
PYPSX_PAPER=True

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8000
USE_PYPSX=False
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379
